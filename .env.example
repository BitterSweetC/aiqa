# ─────────────────────────────────────────────────────────────
# AIQA Configuration & AI Model Setup
# ─────────────────────────────────────────────────────────────
# NOTE: AIQA works 100% out of the box with ZERO API keys required!
# It will use its built-in Intelligent Heuristic Engine for planning,
# browser actions, and failure analysis.
#
# If you want to enable deeper AI reasoning and vision review,
# configure one of the options below:
# ─────────────────────────────────────────────────────────────

# ─── Option 1: OpenAI (Default) ──────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Option 2: DeepSeek (Cost-Effective Alternative) ─────────
# OPENAI_API_KEY=your-deepseek-api-key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# ─── Option 3: Local Ollama or Custom Endpoint ───────────────
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3:latest

# ─── Browser Automation Settings ─────────────────────────────
HEADLESS=true
BROWSER_TIMEOUT=30000
